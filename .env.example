# ==============================================================================
# Provision Shop Management System — Environment Variables
# Copy to .env and fill in real credentials. Never commit .env or secrets.
# ==============================================================================

# Public Supabase client keys (safe for browser via Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side Supabase service role key (KEEP SECRET — server.ts / Edge Functions ONLY)
SUPABASE_SERVICE_ROLE_KEY=

# Server-side Cashier Session HMAC signing secret (generate random 32+ byte hex string)
CASHIER_SESSION_SECRET=

# Public App URL (used for QR expense submission links and webhooks)
APP_URL=http://localhost:3000

# Moolre Mobile Money API (Server-side ONLY)
MOOLRE_API_BASE_URL=https://api.moolre.com
MOOLRE_API_USER=
MOOLRE_API_PUBKEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_WEBHOOK_SECRET=

# SasuSync SMS API (Server-side ONLY — configure once official credentials & endpoint are obtained)
SASUSYNC_API_ENDPOINT=
SASUSYNC_API_KEY=
SASUSYNC_SENDER_ID=

# Cron / Scheduled report invocation secret
CRON_SECRET=
